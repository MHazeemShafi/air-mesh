# ==============================================================================
# AirMesh Environment Configuration
# Copy this file to .env.local for local development or configure in Vercel.
# ==============================================================================

# 1. OpenAQ API (https://openaq.org/)
# API Key for accessing v3 OpenAQ endpoints (CPCB monitoring station data)
OPENAQ_API_KEY=your_openaq_api_key_here

# 2. Supabase Database & Auth (https://supabase.com/)
# Project URL from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Secret (bypasses RLS for secure serverless API backend operations)
# WARNING: NEVER expose this key in client-side bundles or public repositories!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Resend Email Service (https://resend.com/)
# API Key from Resend API Keys dashboard
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Email Address (must use a verified domain in Resend for production)
# e.g., "AirMesh Alerts <alerts@yourdomain.com>" or "onboarding@resend.dev" for testing
RESEND_FROM_EMAIL=AirMesh <alerts@yourdomain.com>

# 4. Application URL
# Root URL of the deployed application (used for email confirmation and settings links)
# Local: http://localhost:5173 (or http://localhost:3000 with vercel dev)
# Production: https://your-airmesh-app.vercel.app
APP_URL=https://your-airmesh-app.vercel.app

# 5. Cron Authentication Secret
# Random 32+ character string to authenticate Vercel daily scheduled jobs
# Call endpoint with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_random_secure_cron_secret_here

# 6. (Optional) Local Vite API Proxy Override
# Set if proxying to a local backend instance during 'npm run dev'
# VITE_API_URL=http://localhost:3000
